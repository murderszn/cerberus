# Cerberus suppression list — glob per line, # for comments.
#
# These files ARE the detection catalog. They contain every vulnerability pattern
# Cerberus looks for, written out as string literals, so scanning them makes the
# tool detect its own signatures and report itself as critically vulnerable.
# They are data, not executable code paths.
checks.json
assets/checks.js

# Virtual environment — contains third-party certificates and packages
.venv/**/*

# Generated documentation embeds the same patterns for reference.
documentation/checks.html
docs/scanner-checks.md
docs/examination-spec.md

# Superseded prototype kept for reference, not served as the app.
ceberus-classic.html

# Prose documentation that quotes the checks (describing "verify=False" is not doing it).
documentation/agents.html

# Ignore generated HTML scan reports which contain check signatures
cerberus-report.html

# Sample scan reports contain vulnerability patterns for demo purposes
assets/sample-*.json

# Static shop data — PRODUCTS array is hardcoded, not user input
assets/shop.js

# Agent HTML — innerHTML usages are all preceded by escapeHtml() sanitization
# The OLLAMA_HOST=0.0.0.0 references are documentation text, not actual binding
agent.html

# Persona generator directives contain quoted security advice strings
servers/agent/personas/generate.py
